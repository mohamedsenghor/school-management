########################################
# CONFIGURATION CENTRALISÉE DE L'APPLICATION
# Cette source est utilisée partout où des variables sont nécessaires
########################################

# ============================================
# PARAMÈTRES GÉNÉRAUX DE L'APPLICATION
# ============================================
APP_NAME=school-management
APP_ENVIRONMENT=docker

# ============================================
# CONFIGURATION DE LA BASE DE DONNÉES MYSQL
# ============================================
# Ces variables sont utilisées par:
# - Service MySQL (reconnait MYSQL_* nativement)
# - Script docker-entrypoint.sh pour configurer database.properties depuis le template database.properties.docker
# - PHPMyAdmin pour la connexion

# Identifiants administrateur MySQL
MYSQL_ROOT_PASSWORD=root

# Identifiants utilisateur application
MYSQL_USER=user
MYSQL_PASSWORD=passer123@

# Base de données
MYSQL_DATABASE=classes_management_db

# ============================================
# CONFIGURATION DES SERVICES
# ============================================
# Noms d'hôtes (utilisés pour la communication inter-conteneurs)
DB_HOST=mysql-db
DB_PORT=3306
DB_NAME=${MYSQL_DATABASE}
DB_USERNAME=${MYSQL_USER}
DB_PASSWORD=${MYSQL_PASSWORD}

# ============================================
# CONFIGURATION DES PORTS RÉSEAU
# ============================================
MYSQL_PORT=3306
BACKEND_PORT=8080
FRONTEND_PORT=80
PHPMYADMIN_PORT=8085

# ============================================
# CONFIGURATION DU FRONTEND
# ============================================
# URL de l'API SOAP (relative pour Nginx reverse proxy en production)
VITE_API_URL=/school-management-soap/
FRONTEND_VITE_PORT=5173
